{
  "name": "flywheel-theme",
  "version": "1.0.0",
  "description": "Mono/green, markdown-first CSS theme \u2014 paper ground, deep-green accent, hairline borders. One stylesheet, no build.",
  "keywords": [
    "css",
    "design-system",
    "icons",
    "markdown",
    "monospace",
    "stylesheet",
    "svg-sprite",
    "theme"
  ],
  "homepage": "https://theflywheel.github.io/flywheel-theme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theflywheel/flywheel-theme.git"
  },
  "license": "MIT",
  "style": "flywheel.css",
  "exports": {
    ".": "./flywheel.css",
    "./flywheel.css": "./flywheel.css",
    "./theme.js": "./theme.js",
    "./copy.js": "./copy.js",
    "./share.js": "./share.js",
    "./term.js": "./term.js",
    "./autogrow.js": "./autogrow.js",
    "./hljson.js": "./hljson.js",
    "./datatable.js": "./datatable.js",
    "./vendor/table-core.mjs": "./vendor/table-core.mjs",
    "./icons.css": "./icons.css",
    "./icons.svg": "./icons.svg"
  },
  "files": [
    "flywheel.css",
    "theme.js",
    "copy.js",
    "share.js",
    "term.js",
    "autogrow.js",
    "hljson.js",
    "note.html",
    "og/",
    "README.md",
    "LICENSE",
    "datatable.js",
    "vendor/",
    "icons.css",
    "icons.svg",
    "scripts/"
  ],
  "sideEffects": [
    "*.js"
  ],
  "dependencies": {
    "@tanstack/table-core": "^8.21.3"
  },
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs"
  }
}
